{
  "expo": {
    "name": "Mi Platica",
    "slug": "mi-platica",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "miplatica",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.alexleon001.miplatica"
    },
    "android": {
      "package": "com.alexleon001.miplatica"
    },
    "plugins": ["expo-router", "expo-updates"],
    "experiments": {
      "typedRoutes": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD"
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": null
      }
    }
  }
}
