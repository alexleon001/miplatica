{
  "name": "mi-platica",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Mi Platica — app de finanzas personales con IA, foco Argentina (RN + Expo + Supabase + Claude)",
  "author": "Alexander León",
  "license": "MIT",
  "homepage": "https://github.com/alexleon001/miplatica#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexleon001/miplatica.git"
  },
  "bugs": {
    "url": "https://github.com/alexleon001/miplatica/issues"
  },
  "main": "expo-router/entry",
  "keywords": [
    "finanzas",
    "argentina",
    "expo",
    "react-native",
    "supabase",
    "claude",
    "ai",
    "typescript"
  ],
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "expo:doctor": "expo-doctor",
    "expo:install:check": "expo install --check",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:headed": "playwright test --headed",
    "test:retries": "playwright test --retries=2",
    "test:last-failed": "playwright test --last-failed",
    "test:e2e": "playwright test --project=e2e",
    "test:smoke": "playwright test --project=smoke",
    "test:integration": "playwright test --project=integration",
    "test:report": "playwright show-report",
    "test:allure": "allure generate ./allure-results -o ./allure-report --clean && allure open ./allure-report",
    "test:allure:generate": "allure generate ./allure-results -o ./allure-report --clean",
    "test:allure:open": "allure open ./allure-report",
    "test:sync": "bun run tests/utils/jiraSync.ts",
    "clean": "rm -rf test-results playwright-report allure-results allure-report reports",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write '**/*.{json,yml,yaml,css,scss,html}' --ignore-path .prettierignore",
    "format:check": "prettier --check '**/*.{json,yml,yaml,css,scss,html}' --ignore-path .prettierignore",
    "type-check": "tsc --noEmit",
    "env:validate": "bun run config/validateEnv.ts",
    "api:login": "bun run cli/api-login.ts",
    "api:login:local": "bun run cli/api-login.ts local",
    "api:login:staging": "bun run cli/api-login.ts staging",
    "api:sync": "bun run cli/sync-openapi.ts",
    "api:types": "bunx openapi-typescript api/openapi.json -o api/openapi-types.ts",
    "kata:manifest": "bun run scripts/kata-manifest.ts",
    "kata:manifest:watch": "bun run scripts/kata-manifest.ts --watch",
    "update": "bun run cli/update-boilerplate.ts",
    "resend": "bun run cli/resend.ts",
    "xray": "bun run cli/xray/index.ts",
    "xray:skills": "cp -r cli/xray/skills/ .claude/skills/xray-cli/",
    "pw:install": "playwright install --with-deps chromium",
    "prepare": "husky"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.1.0",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@supabase/supabase-js": "^2.45.4",
    "expo": "~52.0.0",
    "expo-constants": "~17.0.3",
    "expo-linking": "~7.0.3",
    "expo-router": "~4.0.0",
    "expo-status-bar": "~2.0.0",
    "react": "18.3.1",
    "react-native": "0.76.3",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-reanimated": "~3.16.1",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-url-polyfill": "^2.0.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.16.0",
    "@faker-js/faker": "^9.8.0",
    "@playwright/test": "^1.58.2",
    "@types/bun": "^1.3.7",
    "@types/node": "^24.10.1",
    "@types/react": "~18.3.12",
    "allure-playwright": "^3.2.1",
    "eslint": "^9.28.0",
    "expo-doctor": "^1.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "openapi-typescript": "^7.10.1",
    "prettier": "^3.7.4",
    "typescript": "^5.8.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix"
    ],
    "*.{json,yml,yaml,css,scss,html}": [
      "prettier --write --ignore-path .prettierignore"
    ]
  }
}
